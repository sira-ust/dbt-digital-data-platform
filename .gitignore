# dbt
target/
dbt_packages/
logs/
*.log

# Python
.venv/
venv/
__pycache__/
*.pyc

# Local credentials & local-only config — never commit
profiles.yml
.env
.mcp.json
*.pem
.user.yml

# DuckDB local database files
*.duckdb
*.duckdb.wal
*.duckdb.tmp

# Sample data exports — keep only the README and the UC schema snapshot in data/
# (mock parquet in data/mock/ is regenerated by scripts/generate_jdawms_mock.py)
data/*
!data/README.md
!data/uc_schema_snapshot.csv

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Working data files — customer addresses and other extracts staged by hand.
# These are inputs to scripts/, not repo artifacts: they carry real customer
# data, they are large and binary (so every revision bloats the clone), and
# nothing in dbt reads them. 1.address.xlsx reached main by accident in PR #7.
*.xlsx
*.xls

